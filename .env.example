# Copy this file to .env.local and fill in your values.
# Add .env.local to .gitignore — NEVER commit real keys to git.
#
# Supabase — public/anon key only (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# ⚠️ service_role key, DB password, JWT secret = NEVER in client code or git
